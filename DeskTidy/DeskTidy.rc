    CONTROL         "背景色",IDC_BTN_BG_COLOR,"Button",BS_OWNERDRAW | WS_TABSTOP,212,176,88,16
    LTEXT           "文字颜色:",IDC_STATIC,20,197,50,10
    CONTROL         "名称颜色",IDC_BTN_TEXT_COLOR,"Button",BS_OWNERDRAW | WS_TABSTOP,74,196,88,16
    CONTROL         "自动跟随背景",IDC_CHECK_TEXT_AUTO,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,176,198,90,12
    CONTROL         "恢复默认(&R)",IDC_BTN_COLOR_RESET,"Button",BS_OWNERDRAW | WS_TABSTOP,312,196,70,16
    LTEXT           "标题栏透明度:",IDC_STATIC,20,219,58,10
    CONTROL         "",IDC_SLIDER_HEADER_ALPHA,"msctls_trackbar32",TBS_NOTICKS | WS_TABSTOP,82,216,120,16

    LTEXT           "100%",IDC_STATIC_BG_ALPHA_VAL,208,239,30,10
    LTEXT           "点击三个色块分别设置标题栏颜色、背景色与文件名称颜色；名称色可勾选【自动跟随背景】。",IDC_STATIC,20,257,368,10
    LTEXT           "拖动两个滑块设置独立透明度；拖动/缩放窗口会自动保存位置与大小，点【应用】后生效。",IDC_STATIC,20,270,368,10
    CONTROL         "启用层级维护(&Z)：修复遮挡/消失",IDC_CHECK_ZORDER_MAINTAIN,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,20,284,270,12
    CONTROL         "置底采用桌面子窗口（免定时z序维护）",IDC_CHECK_BOTTOM_CHILD,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,20,298,270,12
    CONTROL         "应用(&S)",IDC_BTN_APPLY,"Button",BS_OWNERDRAW | WS_TABSTOP,310,296,74,14
    CONTROL         "开机自启动(&U)：随 Windows 登录后自动运行",IDC_CHECK_AUTOSTART,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,20,322,270,12
    LTEXT           "悬浮置顶:",IDC_STATIC,20,371,80,12
    CONTROL         "",IDC_EDIT_TOP_HOTKEY,"msctls_hotkey32",WS_TABSTOP,104,369,110,14
    CONTROL         "启用",IDC_CHECK_TOP_HOTKEY,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,228,371,50,12
    LTEXT           "置底:",IDC_STATIC,20,391,80,12
    CONTROL         "",IDC_EDIT_BOTTOM_HOTKEY,"msctls_hotkey32",WS_TABSTOP,104,389,110,14
    CONTROL         "启用",IDC_CHECK_BOTTOM_HOTKEY,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,228,391,50,12
    LTEXT           "缩放放大:",IDC_STATIC,20,411,80,12
    CONTROL         "",IDC_EDIT_ZOOMIN_HOTKEY,"msctls_hotkey32",WS_TABSTOP,104,409,110,14
    CONTROL         "启用",IDC_CHECK_ZOOMIN_HOTKEY,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,228,411,50,12
    LTEXT           "缩放缩小:",IDC_STATIC,20,431,80,12
    CONTROL         "",IDC_EDIT_ZOOMOUT_HOTKEY,"msctls_hotkey32",WS_TABSTOP,104,429,110,14
    CONTROL         "启用",IDC_CHECK_ZOOMOUT_HOTKEY,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,228,431,50,12
    LTEXT           "搜索:",IDC_STATIC,20,451,80,12
